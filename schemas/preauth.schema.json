{
  "title": "rizzstack signed pre-authorization envelope",
  "description": "One bounded, owner-signed batch: rizzstack.preauth/2. Additional fields are refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "issuer",
    "issued_at",
    "expires_at",
    "nonce",
    "action_class",
    "repos",
    "bases",
    "contracts",
    "review",
    "budget",
    "conditions",
    "max_uses",
    "created_from"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "rizzstack.preauth/2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Envelope id; the unit of revocation and replay accounting."
    },
    "issuer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._@-]{1,64}$",
      "description": "The owner principal that signs; ssh-keygen -Y verify identity."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "action_class": {
      "type": "string",
      "enum": [
        "merge_slice",
        "refreeze_contract",
        "vendor_sync",
        "close_superseded_pr",
        "dispatch_wave"
      ]
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "review": {
      "type": "object"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_merges",
        "max_bees",
        "max_attempts_per_contract"
      ],
      "properties": {
        "max_merges": {
          "type": "integer",
          "minimum": 1
        },
        "max_bees": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_attempts_per_contract": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "max_uses": {
      "type": "integer",
      "minimum": 1
    },
    "created_from": {
      "type": "string",
      "minLength": 1
    }
  }
}
